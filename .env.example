# Necesaria para que /contacto pueda enviar correos vía Resend.
# Se configura en Vercel → Project Settings → Environment Variables,
# en Production Y en Preview (si falta en Preview, el build de la rama
# de preview puede fallar al llamar rutas de API que la usen).
RESEND_API_KEY=

# Supabase — se obtiene en Settings → API del proyecto en supabase.com.
# Las dos primeras son públicas (aparecen en el browser).
# La tercera es secreta (solo en el servidor, nunca en el browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
