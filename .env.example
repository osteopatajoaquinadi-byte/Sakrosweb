# Necesaria para que /contacto pueda enviar correos vía Resend.
# Se configura en Vercel → Project Settings → Environment Variables,
# en Production Y en Preview (si falta en Preview, el build de la rama
# de preview puede fallar al llamar rutas de API que la usen).
RESEND_API_KEY=

# Supabase — se obtiene en Settings → API del proyecto en supabase.com.
# Las dos primeras son públicas (aparecen en el browser).
# La tercera es secreta (solo en el servidor, nunca en el browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bot de Instagram (Método REST acompañado, palabra clave "sueño").
# Se obtienen en developers.facebook.com → tu app → Instagram API.
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Texto libre: el mismo que se ingresa al registrar el webhook en Meta.
IG_VERIFY_TOKEN=
# Opcional: id de la cuenta de Instagram (por defecto "me").
IG_ACCOUNT_ID=
# Link de pago del programa ($97.000) que el bot envía al aceptar.
REST_PAYMENT_URL=

# Opcional: reservar también en Wix Bookings mientras se use Wix.
WIX_API_KEY=
WIX_SITE_ID=
WIX_REST_SERVICE_ID=
